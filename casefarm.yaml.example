# 本地额外节点（不会提交真实密码，复制为 casefarm.yaml 后填写）
proxies:
  - { name: '🇯🇵 示例节点', type: anytls, server: 127.0.0.1, port: 443, password: CHANGE_ME, client-fingerprint: chrome, udp: true, sni: example.com, alpn: [h2, http/1.1], skip-cert-verify: true }

proxy-groups:
